<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="18dp">

    <LinearLayout
        android:id="@+id/balance_pane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#3DDC84" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/balance" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="22sp"
            android:textStyle="bold" />
        <TextView android:id="@+id/last" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:gravity="center" android:textColor="#BDC1C6" android:textSize="12sp" />
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="#9AA0A6" android:textSize="10sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/tap_for_qr" android:textColor="#9AA0A6" android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/qr"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="14dp"
        android:background="#FFFFFF"
        android:contentDescription="@string/tap_for_qr"
        android:scaleType="fitCenter"
        android:visibility="gone" />
</FrameLayout>
