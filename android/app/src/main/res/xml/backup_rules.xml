<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. Nothing is backed up: the wallet database, sealed keys,
     background-sync view key and widget snapshot all stay on this device. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
